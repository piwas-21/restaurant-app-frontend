# Environment Variables Template
# Copy this file to .env.local for local development.
# scripts/dev-secrets.sh does this for you on first setup.
#
# .env.local is gitignored. NEVER commit credentials.

# ── Application environment ──────────────────────────────────────────
# Used by build-time / runtime checks. Common values: development, preview, production.
NEXT_PUBLIC_APP_ENV=development

# ── Backend API URL (base URL only, without /api suffix) ─────────────
# Local development: http://localhost:5221 (or your backend port)
# Production: https://rumirestaurant.ch (Ingress will route /api to backend)
# Note: Your API routes should include /api prefix (e.g., /api/Products)
NEXT_PUBLIC_API_URL=http://localhost:5221

# ── Restaurant display name (page metadata; baked at build time) ─────
# Per-tenant images bake the registry `name`; RUMI prod bakes its own in
# build-image.yml. Falls back to a neutral "Restaurant" when unset.
NEXT_PUBLIC_RESTAURANT_NAME=Rumi Restaurant

# ── Image / asset base URL ───────────────────────────────────────────
# Local development: same-origin as the dev backend (serves /uploads)
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:5221

# ── Error tracking (Sentry — DEV-PHASES W3) ──────────────────────────
# SERVER-SIDE only (SSR / route handlers / RSC). Read at runtime on the box.
# Empty = disabled (the SDK is a no-op; the build stays green). NOT baked into
# the client bundle — browser-side capture is deferred because it needs a CSP
# connect-src change in next.config.ts (a §9 explicit-instruction-only edit).
# The DSN is Sentry SaaS EU (EU data residency); self-host later = env swap.
SENTRY_DSN=
# Optional: label events by environment (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=

# ── Test-account credentials (Playwright E2E + manual local sign-in) ──
# These were previously committed in `.env`. They are now per-developer:
# fill in your own dev/test credentials here in your local `.env.local`.
# Format: JSON-ish single-quoted string with email + password fields.
# Examples (NOT real credentials — replace with your own dev/test values):
#   ADMIN='{email: admin@example.local, password: change-me}'
#   CASHIER='{email: cashier@example.local, password: change-me}'
#   CUSTOMER='{email: customer@example.local, password: change-me}'
#
# `e2e/helpers/adminAuth.ts` reads this file FIRST and the process environment
# second, so the same credential can also arrive as a plain pair — which is what
# CI uses, because a workflow must never write a dotfile holding a credential
# into the workspace (issue #585):
#   ADMIN_EMAIL=admin@example.local
#   ADMIN_PASSWORD=<your own dev value>
# The password below is intentionally EMPTY here and everywhere in git. CI's
# admin lives only in its own ephemeral postgres container and is set in
# .github/workflows/ci.yml; it is not a credential for any deployed host.
ADMIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CASHIER=
CUSTOMER=
